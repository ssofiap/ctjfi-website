{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["ESNext"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "moduleResolution": "bundler",
    "module": "ESNext"
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules", "frontend", "frontend/node_modules", "frontend/.next"]
}